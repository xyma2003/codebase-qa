pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    limit_req_zone $binary_remote_addr zone=requests:1m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    limit_req_status 429;
    limit_conn_status 429;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    upstream backend { server app:8501; }
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 444;
    }
    server {
        listen 8443 ssl;
        server_name __HOSTNAME__;
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 2m;
        client_body_timeout 15s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        location = /healthz {
            limit_req zone=requests burst=10 nodelay;
            proxy_pass http://backend/_stcore/health;
            proxy_set_header Host __HOSTNAME__;
        }
        location / {
            limit_req zone=requests burst=20 nodelay;
            limit_conn connections 6;
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host __HOSTNAME__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 360s;
            proxy_send_timeout 30s;
            proxy_buffering off;
        }
    }
}
